{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": false,
    "types": ["jest", "@testing-library/jest-dom", "node"]
  },
  "include": [
    "src",
    "src/setupTests.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}